{
  "manifest_version": 3,
  "name": "JobPilot - Universal Job Portal Assistant",
  "version": "0.5.2",
  "description": "Universal portal capture with deterministic quick relevance filtering for listing pages.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.puter.com/*",
    "https://puter.com/*",
    "https://naukri.com/*",
    "https://www.naukri.com/*",
    "https://*.naukri.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open JobPilot"
  },
  "options_page": "onboarding/onboarding.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.puter.com https://puter.com; worker-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://naukri.com/*",
        "https://www.naukri.com/*",
        "https://*.naukri.com/*"
      ],
      "js": [
        "core/portal-engine.js",
        "portals/naukri/listing.js",
        "portals/naukri/detail.js",
        "portals/naukri/adapter.js",
        "core/relevance-gate.js",
        "content/portal-runtime.js"
      ],
      "css": [
        "content/portal-runtime.css"
      ],
      "run_at": "document_idle"
    }
  ]
}