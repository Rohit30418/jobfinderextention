{
  "manifest_version": 3,
  "name": "JobPilot - Universal Job Portal Assistant",
  "version": "1.9.0",
  "description": "AI-rank captured jobs against your career profile with evidence-grounded fit scores, full reviews, and optional Puter AI.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.puter.com/*",
    "https://puter.com/*",
    "https://naukri.com/*",
    "https://www.naukri.com/*",
    "https://*.naukri.com/*",
    "https://foundit.in/*",
    "https://www.foundit.in/*",
    "https://*.foundit.in/*",
    "https://www.linkedin.com/jobs/*",
    "https://*.linkedin.com/jobs/*",
    "https://in.indeed.com/*",
    "https://*.indeed.com/*",
    "https://hirist.tech/*",
    "https://www.hirist.tech/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://www.indeed.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open JobPilot Job List"
  },
  "options_page": "onboarding/onboarding.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.puter.com https://puter.com; worker-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://naukri.com/*",
        "https://www.naukri.com/*",
        "https://*.naukri.com/*"
      ],
      "js": [
        "core/portal-engine.js",
        "portals/naukri/listing.js",
        "portals/naukri/detail.js",
        "portals/naukri/adapter.js",
        "core/relevance-gate.js",
        "content/portal-runtime.js",
        "content/detail-intelligence.js"
      ],
      "css": [
        "content/portal-runtime.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://foundit.in/*",
        "https://www.foundit.in/*",
        "https://*.foundit.in/*"
      ],
      "js": [
        "core/portal-engine.js",
        "portals/shared/portal-utils.js",
        "portals/foundit/listing.js",
        "portals/foundit/detail.js",
        "portals/foundit/adapter.js",
        "core/relevance-gate.js",
        "content/portal-runtime.js",
        "content/detail-intelligence.js"
      ],
      "css": [
        "content/portal-runtime.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.linkedin.com/jobs/*"
      ],
      "js": [
        "core/portal-engine.js",
        "portals/shared/portal-utils.js",
        "portals/linkedin/listing.js",
        "portals/linkedin/detail.js",
        "portals/linkedin/adapter.js",
        "core/relevance-gate.js",
        "content/portal-runtime.js",
        "content/detail-intelligence.js"
      ],
      "css": [
        "content/portal-runtime.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://in.indeed.com/*",
        "https://*.indeed.com/*"
      ],
      "js": [
        "core/portal-engine.js",
        "portals/shared/portal-utils.js",
        "portals/indeed/listing.js",
        "portals/indeed/detail.js",
        "portals/indeed/adapter.js",
        "core/relevance-gate.js",
        "content/portal-runtime.js",
        "content/detail-intelligence.js"
      ],
      "css": [
        "content/portal-runtime.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hirist.tech/*",
        "https://www.hirist.tech/*"
      ],
      "js": [
        "core/portal-engine.js",
        "portals/shared/portal-utils.js",
        "portals/hirist/listing.js",
        "portals/hirist/detail.js",
        "portals/hirist/adapter.js",
        "core/relevance-gate.js",
        "content/portal-runtime.js",
        "content/detail-intelligence.js"
      ],
      "css": [
        "content/portal-runtime.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "minimum_chrome_version": "120",
  "externally_connectable": {
    "matches": [
      "https://rohit30418.github.io/*"
    ]
  }
}
