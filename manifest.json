{
  "manifest_version": 3,
  "name": "JobPilot - Universal Job Portal Assistant",
  "version": "1.1.0",
  "description": "JobPilot 1.1: Naukri, Foundit, LinkedIn Jobs, Indeed and Hirist with shared listing capture and full inline Match % + AI detail analysis.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.puter.com/*",
    "https://puter.com/*",
    "https://naukri.com/*",
    "https://www.naukri.com/*",
    "https://*.naukri.com/*",
    "https://foundit.in/*",
    "https://www.foundit.in/*",
    "https://*.linkedin.com/jobs/*",
    "https://in.indeed.com/*",
    "https://*.indeed.com/*",
    "https://hirist.tech/*",
    "https://www.hirist.tech/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open JobPilot Job List"
  },
  "options_page": "onboarding/onboarding.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.puter.com https://puter.com; worker-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://naukri.com/*",
        "https://www.naukri.com/*",
        "https://*.naukri.com/*"
      ],
      "js": [
        "core/portal-engine.js",
        "portals/naukri/listing.js",
        "portals/naukri/detail.js",
        "portals/naukri/adapter.js",
        "core/relevance-gate.js",
        "content/portal-runtime.js",
        "content/detail-intelligence.js"
      ],
      "css": [
        "content/portal-runtime.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://foundit.in/*",
        "https://www.foundit.in/*",
        "https://*.linkedin.com/jobs/*",
        "https://in.indeed.com/*",
        "https://*.indeed.com/*",
        "https://hirist.tech/*",
        "https://www.hirist.tech/*"
      ],
      "js": [
        "core/portal-engine.js",
        "portals/shared/configured-factory.js",
        "portals/shared/configured-portals.js",
        "core/relevance-gate.js",
        "content/portal-runtime.js",
        "content/detail-intelligence.js"
      ],
      "css": [
        "content/portal-runtime.css"
      ],
      "run_at": "document_idle"
    }
  ]
}