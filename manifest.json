{
  "manifest_version": 3,
  "name": "JobPilot - Naukri Job Extractor",
  "version": "0.4.1",
  "description": "Stage 4 structured Naukri extraction with reliable content-script injection diagnostics.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://api.puter.com/*",
    "https://puter.com/*",
    "https://www.naukri.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open JobPilot"
  },
  "options_page": "onboarding/onboarding.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.puter.com https://puter.com; worker-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.naukri.com/*"
      ],
      "js": [
        "content/naukri-detector.js",
        "content/naukri-extractor.js"
      ],
      "css": [
        "content/naukri-detector.css",
        "content/naukri-extractor.css"
      ],
      "run_at": "document_idle"
    }
  ]
}